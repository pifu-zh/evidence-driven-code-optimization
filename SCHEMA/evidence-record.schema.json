{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence Record",
  "type": "object",
  "required": ["id", "title", "kind", "status", "problem", "verification"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": ["bug", "performance", "extension", "refactor"]
    },
    "status": {
      "type": "string",
      "enum": [
        "investigating",
        "reproduced",
        "root-cause-confirmed",
        "patch-ready",
        "verified",
        "accepted",
        "rejected",
        "blocked"
      ]
    },
    "owner": {
      "type": "string"
    },
    "created": {
      "type": "string",
      "format": "date"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "problem": {
      "type": "object",
      "required": ["symptom", "expected", "actual"],
      "properties": {
        "symptom": {
          "type": "string"
        },
        "expected": {
          "type": "string"
        },
        "actual": {
          "type": "string"
        },
        "impact": {
          "type": "string",
          "enum": ["blocker", "major", "minor", "internal", "unknown"]
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "reproduction": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["functional", "performance", "concurrency", "manual"]
        },
        "command": {
          "type": "string"
        },
        "input": {
          "type": "string"
        },
        "expected": {
          "type": "string"
        },
        "actual": {
          "type": "string"
        },
        "stable": {
          "type": "boolean"
        },
        "repeat": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "hypothesis", "status"],
        "properties": {
          "id": {
            "type": "string"
          },
          "hypothesis": {
            "type": "string"
          },
          "code_location": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "prediction": {
            "type": "string"
          },
          "experiment": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["untested", "confirmed", "rejected", "inconclusive"]
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "required": ["failing_test_reproduces_old_behavior"],
      "properties": {
        "failing_test_reproduces_old_behavior": {
          "type": "boolean"
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "static_checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "benchmarks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "phase"],
            "properties": {
              "name": {
                "type": "string"
              },
              "phase": {
                "type": "string",
                "enum": ["before", "after", "regression"]
              },
              "artifact": {
                "type": "string"
              },
              "summary": {
                "type": "object"
              }
            }
          }
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "properties": {
        "decision": {
          "type": "string",
          "enum": ["accepted", "rejected", "blocked"]
        },
        "root_cause_family": {
          "type": "string"
        },
        "confidence": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "reviewer": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "follow_ups": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
